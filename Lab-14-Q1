data class Student(val name: String, val percentage: Int)

fun main() {
    val list = listOf(10, 20, 30)
    val mList = mutableListOf(10, 20, 30)
    mList.add(40)
    mList.remove(20)
    println("List: $list")
    println("Mutable List: $mList")
    println(mList.contains(30))
    println(mList[0])

    val set = setOf(1, 2, 3)
    val mSet = mutableSetOf(1, 2, 3)
    mSet.add(4)
    mSet.remove(2)
    println("Set: $set")
    println("Mutable Set: $mSet")
    println(mSet.contains(3))

    val map = mapOf(1 to "A", 2 to "B")
    val mMap = mutableMapOf(1 to "A", 2 to "B")
    mMap[3] = "C"
    mMap.remove(2)
    println("Map: $map")
    println("Mutable Map: $mMap")
    println(mMap.containsKey(1))
    println(mMap[3])

    val numbers = listOf(1, 2, 3, 4, 5)
    println("Original: $numbers")
    println("Map: ${numbers.map { it * 2 }}")
    println("Filter: ${numbers.filter { it % 2 == 0 }}")
    println("Reduce: ${numbers.reduce { a, b -> a + b }}")

    val students = listOf(
        Student("Aman", 80),
        Student("Rahul", 70),
        Student("Vignesh", 90)
    )

    println("Sorted: ${students.sortedBy { it.percentage }}")
    println("Grouped: ${students.groupBy { it.percentage >= 80 }}")
}
