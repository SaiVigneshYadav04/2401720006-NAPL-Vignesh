
package main

import (
	"fmt"
	"exp2/myutils"
)

func main() {
	str := "Hello"

	fmt.Println("Original String:", str)
	fmt.Println("Reversed String:", myutils.Reverse(str))
	fmt.Println("Number of Vowels:", myutils.CountVowels(str))

	fmt.Println("Factorial of 5:", myutils.Factorial(5))
	fmt.Println("Power of 2^3:", myutils.Power(2, 3))
}
