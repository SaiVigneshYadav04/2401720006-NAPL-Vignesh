data class Product(
    val name: String,
    val price: Int,
    val category: String? = null
)

fun main() {
    val products = listOf(
        Product("Mouse", 500, "Electronics"),
        Product("Keyboard", 1000, "Electronics"),
        Product("Notebook", 100)
    )

    println("Product Names:")
    println(products.map { it.name })

    println("Products above 200:")
    println(products.filter { it.price > 200 })

    println("Total Price:")
    println(products.map { it.price }.reduce { a, b -> a + b })

    println("Products by Category:")
    println(products.groupBy { it.category ?: "Other" })
}
