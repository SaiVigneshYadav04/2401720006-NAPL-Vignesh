fun main() {

    // 1. Hello Kotlin
    println("Hello Kotlin!!!")


    // 2. Employee Bonus
    print("Enter Department: ")
    val dept = readLine()!!

    print("Enter Experience: ")
    val years = readLine()!!.toInt()

    print("Enter Salary: ")
    val salary = readLine()!!.toDouble()

    val bonus = when {
        dept == "IT" && years > 5 -> salary * 20 / 100
        dept == "HR" && years > 3 -> salary * 15 / 100
        else -> salary * 10 / 100
    }

    println("Employee Bonus = $bonus")


    // 3. Average of Digits
    print("Enter a number: ")
    var num = readLine()!!.toInt()

    num = kotlin.math.abs(num)

    var sum = 0
    var count = 0

    while (num > 0) {
        sum += num % 10
        count++
        num /= 10
    }

    if (count == 0) count = 1

    val average = sum.toDouble() / count

    println("Average of digits = $average")
}
