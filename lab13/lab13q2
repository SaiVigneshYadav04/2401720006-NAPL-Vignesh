fun display(name: String = "John", age: Int = 20) {
    println("Name: $name, Age: $age")
}

fun numbers(vararg num: Int) {
    for (n in num) {
        println(n)
    }
}

fun calculate(list: List<Int>, operation: (Int) -> Int) {
    for (n in list) {
        println(operation(n))
    }
}

fun main() {

    display()
    display("Ram", 25)
    display(age = 30, name = "Sam")
    numbers(10, 20, 30, 40, 50)
    val list = listOf(1, 2, 3, 4, 5)

    calculate(list) { it * 2 }
}
